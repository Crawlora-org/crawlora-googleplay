{
  "name": "@crawlora-org/googleplay",
  "version": "0.1.1",
  "description": "Crawlora Google Play API client with 11 endpoints for app search, details, reviews, ratings, permissions, data safety, charts, similar apps, and developers",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=googleplay-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-googleplay/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "googleplay", "google-play", "googleplay-api", "google-play-api", "googleplay-scraper", "google-play-scraper", "googleplay-data", "google-play-data", "googleplay-app-search", "googleplay-details", "googleplay-reviews", "googleplay-ratings", "googleplay-permissions", "googleplay-data-safety", "googleplay-charts"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-googleplay",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
