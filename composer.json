{
  "name": "crawlora/googleplay",
  "description": "Google Play client for the Crawlora hosted API",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Googleplay\\": "php/src/Crawlora/Googleplay/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Googleplay\\Tests\\": "php/tests/"
    }
  },
  "scripts": {
    "test": "php php/tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=googleplay-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-googleplay",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=googleplay-php-api-docs"
  }
}
